# DED-PMH env contract (Phase 0).
# Copy to `.env.local` and fill values. Never commit `.env.local` or `service.json`.

# ── Public site (safe to expose in the browser) ──────────────────────────────
NEXT_PUBLIC_SITE_NAME=DED-PMH
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_BRAND_SHORT=DED · Phú Mỹ Hưng
# Optional Cloud Function for fact-sheet PDF. Unset = browser print fallback.
NEXT_PUBLIC_PDF_FUNCTION_URL=

# ── Firebase client (Phase 4 only — unused until then) ───────────────────────
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ── Firebase Admin (Phase 4 only — server). Prefer a local key file: ────────
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Leave FIREBASE_PRIVATE_KEY empty when using the key file path below.
FIREBASE_PRIVATE_KEY=
GOOGLE_APPLICATION_CREDENTIALS=./service.json

# ── CMS bootstrap (server only — never commit real values) ───────────────────
# Any Firebase Auth user may use CMS (no RBAC). These credentials create the
# first operator if the account does not exist yet.
CMS_BOOTSTRAP_EMAIL=
CMS_BOOTSTRAP_PASSWORD=

# ── Ops / luxury QA (scripts only) ───────────────────────────────────────────
AUDIT_BASE_URL=http://localhost:3000
PROD_BASE_URL=https://de-division-pmh.vercel.app
LUXURY_MIN_INDEX=85
# PW_CHANNEL=chrome
# PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=
